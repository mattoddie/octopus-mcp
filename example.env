# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- Octopus Energy -----------------------------------------------------------
# Your API key, from https://octopus.energy/dashboard/new/accounts/personal-details/api-access
# It starts sk_live_ and gives read access to your account (and, through the
# GraphQL API, some changes such as EV charging settings). Keep it secret.
OCTOPUS_API_KEY=
# Your account number, like A-1234ABCD. Optional: when the key can only see one
# account, it is found automatically.
OCTOPUS_ACCOUNT=

# Register tools that change things: EV charging target and ready-by time, bump
# charges, smart charging on/off, and joining Saving Sessions.
OCTOPUS_ALLOW_WRITES=false
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model.
# account,consumption,tariffs,intelligent,octoplus,raw
OCTOPUS_TOOLSETS=all
OCTOPUS_TIMEOUT_MS=30000
# The APIs. You shouldn't need to change these.
# OCTOPUS_API_URL=https://api.octopus.energy
# OCTOPUS_GRAPHQL_URL=https://api.octopus.energy/v1/graphql/
# OCTOPUS_BACKEND_GRAPHQL_URL=https://api.backend.octopus.energy/v1/graphql/

# --- MCP transport ------------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http (the server refuses to start without it): clients must send
# "Authorization: Bearer <token>".  Generate one with: openssl rand -hex 32
# Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Optional comma-separated Host header allow-list (DNS rebinding protection).
MCP_ALLOWED_HOSTS=
